	<id>BoredSkull:SocialMediaLinks</id>
	<name>Social Media Links</name>
	<version>1.1.1</version>
	<type>modification</type>

	<install for="2.1.*">
		<readme parsebbc="true">readme.txt</readme>
		<database>install.php</database>

		<require-file name="Sources/SocialLinks.php" destination="$sourcedir" />
		<require-file name="Themes/default/SocialLinks.template.php" destination="$themedir" />
		<require-file name="Themes/default/languages/SocialLinks.english.php" destination="$languagedir" />
		<require-file name="Themes/default/languages/SocialLinks.finnish.php" destination="$languagedir" />
		<require-file name="Themes/default/css/sociallinks.css" destination="$themedir/css" />

		<hook hook="integrate_pre_include" function="$sourcedir/SocialLinks.php" />
		<hook hook="integrate_load_permissions" function="sociallinks_load_permissions" />
		<hook hook="integrate_load_illegal_guest_permissions" function="sociallinks_illegal_guest_permissions" />
		<hook hook="integrate_load_member_data" function="sociallinks_load_member_data" />
		<hook hook="integrate_display_topic" function="sociallinks_display_topic" />
		<hook hook="integrate_prepare_display_context" function="sociallinks_prepare_display_context" />
		<hook hook="integrate_profile_areas" function="sociallinks_profile_areas" />
		<hook hook="integrate_admin_areas" function="sociallinks_admin_areas" />
		<hook hook="integrate_modify_modifications" function="sociallinks_modify_modifications" />
		<hook hook="integrate_credits" function="sociallink_credits" file="$sourcedir/SocialLinks.php" />

		<redirect url="?action=admin;area=modsettings;sa=sociallinks" timeout="3000" />
	</install>

	<upgrade from="1.0.1" for="2.1.*">
		<readme parsebbc="true">readme.txt</readme>
		<require-file name="Sources/SocialLinks.php" destination="$sourcedir" />
		<require-file name="Themes/default/SocialLinks.template.php" destination="$themedir" />
		<require-file name="Themes/default/languages/SocialLinks.english.php" destination="$languagedir" />
		<require-file name="Themes/default/languages/SocialLinks.finnish.php" destination="$languagedir" />
		<require-file name="Themes/default/css/sociallinks.css" destination="$themedir/css" />
		<hook hook="integrate_general_mod_settings" function="sociallinks_mod_settings" reverse="true" />
		<hook hook="integrate_admin_areas" function="sociallinks_admin_areas" />
		<hook hook="integrate_modify_modifications" function="sociallinks_modify_modifications" />
	</upgrade>
	<upgrade from="1.0.2" for="2.1.*">
		<readme parsebbc="true">readme.txt</readme>
		<require-file name="Sources/SocialLinks.php" destination="$sourcedir" />
		<require-file name="Themes/default/SocialLinks.template.php" destination="$themedir" />
		<require-file name="Themes/default/languages/SocialLinks.english.php" destination="$languagedir" />
		<require-file name="Themes/default/languages/SocialLinks.finnish.php" destination="$languagedir" />
		<require-file name="Themes/default/css/sociallinks.css" destination="$themedir/css" />
		<hook hook="integrate_general_mod_settings" function="sociallinks_mod_settings" reverse="true" />
		<hook hook="integrate_admin_areas" function="sociallinks_admin_areas" />
