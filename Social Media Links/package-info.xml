	</upgrade>

	<upgrade from="1.1.0" for="2.1.*">
		<readme parsebbc="true">readme.txt</readme>
		<require-file name="Sources/SocialLinks.php" destination="$sourcedir" />
		<require-file name="Themes/default/SocialLinks.template.php" destination="$themedir" />
		<require-file name="Themes/default/languages/SocialLinks.english.php" destination="$languagedir" />
		<require-file name="Themes/default/languages/SocialLinks.finnish.php" destination="$languagedir" />
		<require-file name="Themes/default/css/sociallinks.css" destination="$themedir/css" />
	</upgrade>

	<uninstall for="2.1.*">
		<hook hook="integrate_pre_include" function="$sourcedir/SocialLinks.php" reverse="true" />
		<hook hook="integrate_load_permissions" function="sociallinks_load_permissions" reverse="true" />
		<hook hook="integrate_load_illegal_guest_permissions" function="sociallinks_illegal_guest_permissions" reverse="true" />
		<hook hook="integrate_load_member_data" function="sociallinks_load_member_data" reverse="true" />
		<hook hook="integrate_display_topic" function="sociallinks_display_topic" reverse="true" />
		<hook hook="integrate_prepare_display_context" function="sociallinks_prepare_display_context" reverse="true" />
		<hook hook="integrate_profile_areas" function="sociallinks_profile_areas" reverse="true" />
		<hook hook="integrate_admin_areas" function="sociallinks_admin_areas" reverse="true" />
		<hook hook="integrate_modify_modifications" function="sociallinks_modify_modifications" reverse="true" />
		<hook hook="integrate_credits" function="sociallink_credits" file="$sourcedir/SocialLinks.php" reverse="true" />

		<remove-file name="$sourcedir/SocialLinks.php" />
		<remove-file name="$themedir/SocialLinks.template.php" />
		<remove-file name="$languagedir/SocialLinks.english.php" />
		<remove-file name="$languagedir/SocialLinks.finnish.php" />
		<remove-file name="$themedir/css/sociallinks.css" />

		<database>uninstall.php</database>
	</uninstall>
</package-info>
