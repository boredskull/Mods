<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info">
<package-info xmlns="http://www.simplemachines.org/xml/package-info" xmlns:smf="http://www.simplemachines.org/">
	<id>BoredSkull:ProfileWall</id>
	<name>Profile Wall</name>
	<version>1.1.2</version>
	<type>modification</type>

	<install for="2.1.*">
		<readme parsebbc="true">readme.txt</readme>
		<database>install.php</database>

		<require-file name="Sources/ProfileWall.php" destination="$sourcedir" />
		<require-file name="Sources/ProfileWall-Hooks.php" destination="$sourcedir" />
		<require-file name="Themes/default/ProfileWall.template.php" destination="$themedir" />
		<require-file name="Themes/default/languages/ProfileWall.english.php" destination="$languagedir" />
		<require-file name="Themes/default/css/profilewall.css" destination="$themedir/css" />
		<require-file name="Themes/default/scripts/profilewall.js" destination="$themedir/scripts" />

		<hook hook="integrate_load_theme" function="pw_load_theme" file="$sourcedir/ProfileWall-Hooks.php" />
		<hook hook="integrate_profile_areas" function="pw_profile_areas" file="$sourcedir/ProfileWall-Hooks.php" />
		<hook hook="integrate_admin_areas" function="pw_admin_areas" file="$sourcedir/ProfileWall-Hooks.php" />
		<hook hook="integrate_load_permissions" function="pw_load_permissions" file="$sourcedir/ProfileWall-Hooks.php" />
		<hook hook="integrate_load_illegal_guest_permissions" function="pw_illegal_guest_permissions" file="$sourcedir/ProfileWall-Hooks.php" />
		<hook hook="integrate_post_ban_permissions" function="pw_ban_permissions" file="$sourcedir/ProfileWall-Hooks.php" />
		<hook hook="integrate_fetch_alerts" function="pw_fetch_alerts" file="$sourcedir/ProfileWall-Hooks.php" />
		<hook hook="integrate_alert_types" function="pw_alert_types" file="$sourcedir/ProfileWall-Hooks.php" />
		<hook hook="integrate_delete_members" function="pw_delete_members" file="$sourcedir/ProfileWall-Hooks.php" />
		<hook hook="integrate_credits" function="pw_credits" file="$sourcedir/ProfileWall-Hooks.php" />

		<redirect url="?action=admin;area=profilewall;sa=settings" timeout="3000" />
	</install>

	<!-- Data-preserving upgrade: reuse existing tables, settings and installed hooks. -->
	<upgrade from="1.0.*" for="2.1.*">
		<readme parsebbc="true">readme.txt</readme>
		<require-file name="Sources/ProfileWall.php" destination="$sourcedir" />
		<require-file name="Sources/ProfileWall-Hooks.php" destination="$sourcedir" />
		<require-file name="Themes/default/ProfileWall.template.php" destination="$themedir" />
		<require-file name="Themes/default/languages/ProfileWall.english.php" destination="$languagedir" />
		<require-file name="Themes/default/css/profilewall.css" destination="$themedir/css" />
		<require-file name="Themes/default/scripts/profilewall.js" destination="$themedir/scripts" />
		<hook hook="integrate_fetch_alerts" function="pw_fetch_alerts" file="$sourcedir/ProfileWall-Hooks.php" />
	</upgrade>

	<upgrade from="1.1.0,1.1.1" for="2.1.*">
		<readme parsebbc="true">readme.txt</readme>
		<require-file name="Sources/ProfileWall.php" destination="$sourcedir" />
		<require-file name="Sources/ProfileWall-Hooks.php" destination="$sourcedir" />
		<require-file name="Themes/default/ProfileWall.template.php" destination="$themedir" />
		<require-file name="Themes/default/languages/ProfileWall.english.php" destination="$languagedir" />
		<require-file name="Themes/default/css/profilewall.css" destination="$themedir/css" />
		<require-file name="Themes/default/scripts/profilewall.js" destination="$themedir/scripts" />
		<hook hook="integrate_fetch_alerts" function="pw_fetch_alerts" file="$sourcedir/ProfileWall-Hooks.php" />
	</upgrade>

	<uninstall for="2.1.*">
		<hook hook="integrate_load_theme" function="pw_load_theme" file="$sourcedir/ProfileWall-Hooks.php" reverse="true" />
		<hook hook="integrate_profile_areas" function="pw_profile_areas" file="$sourcedir/ProfileWall-Hooks.php" reverse="true" />
		<hook hook="integrate_admin_areas" function="pw_admin_areas" file="$sourcedir/ProfileWall-Hooks.php" reverse="true" />
		<hook hook="integrate_load_permissions" function="pw_load_permissions" file="$sourcedir/ProfileWall-Hooks.php" reverse="true" />
		<hook hook="integrate_load_illegal_guest_permissions" function="pw_illegal_guest_permissions" file="$sourcedir/ProfileWall-Hooks.php" reverse="true" />
		<hook hook="integrate_post_ban_permissions" function="pw_ban_permissions" file="$sourcedir/ProfileWall-Hooks.php" reverse="true" />
		<hook hook="integrate_fetch_alerts" function="pw_fetch_alerts" file="$sourcedir/ProfileWall-Hooks.php" reverse="true" />
		<hook hook="integrate_alert_types" function="pw_alert_types" file="$sourcedir/ProfileWall-Hooks.php" reverse="true" />
		<hook hook="integrate_delete_members" function="pw_delete_members" file="$sourcedir/ProfileWall-Hooks.php" reverse="true" />
		<hook hook="integrate_credits" function="pw_credits" file="$sourcedir/ProfileWall-Hooks.php" reverse="true" />

		<remove-file name="$sourcedir/ProfileWall.php" />
		<remove-file name="$sourcedir/ProfileWall-Hooks.php" />
		<remove-file name="$themedir/ProfileWall.template.php" />
		<remove-file name="$languagedir/ProfileWall.english.php" />
		<remove-file name="$themedir/css/profilewall.css" />
		<remove-file name="$themedir/scripts/profilewall.js" />
	</uninstall>
</package-info>
