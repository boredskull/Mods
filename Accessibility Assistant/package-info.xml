<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info">
<package-info xmlns="http://www.simplemachines.org/xml/package-info">
 <id>BoredSkull:AccessibilityAssistant</id>
 <name>Accessibility Assistant</name>
 <version>1.3.1</version>
 <type>modification</type>
 <install for="2.1.0 - 2.1.99">
  <readme type="file" parsebbc="false">README.md</readme>
  <license type="file">LICENSE.txt</license>
  <require-file name="Sources/AccessibilityAssistant.php" destination="$sourcedir" />
  <require-file name="Themes/default/AccessibilityAssistant.template.php" destination="$themedir" />
  <require-file name="Themes/default/languages/AccessibilityAssistant.english.php" destination="$languagedir" />
  <require-file name="Themes/default/css/accessibility_assistant.css" destination="$themedir/css" />
  <require-file name="Themes/default/scripts/accessibility_assistant.js" destination="$themedir/scripts" />
  <database>install.php</database>
  <hook hook="integrate_actions" function="BoredAccessibilityAssistant::hookActions" file="$sourcedir/AccessibilityAssistant.php" />
  <hook hook="integrate_profile_areas" function="BoredAccessibilityAssistant::hookProfileAreas" file="$sourcedir/AccessibilityAssistant.php" />
  <hook hook="integrate_pre_profile_areas" function="BoredAccessibilityAssistant::hookProfileAreas" file="$sourcedir/AccessibilityAssistant.php" />
  <hook hook="integrate_admin_areas" function="BoredAccessibilityAssistant::hookAdmin" file="$sourcedir/AccessibilityAssistant.php" />
  <hook hook="integrate_load_theme" function="BoredAccessibilityAssistant::hookLoadTheme" file="$sourcedir/AccessibilityAssistant.php" />
  <hook hook="integrate_post_end" function="BoredAccessibilityAssistant::hookPostEnd" file="$sourcedir/AccessibilityAssistant.php" />
 </install>
 <uninstall for="2.1.0 - 2.1.99">
  <hook hook="integrate_actions" function="BoredAccessibilityAssistant::hookActions" file="$sourcedir/AccessibilityAssistant.php" reverse="true" />
  <hook hook="integrate_profile_areas" function="BoredAccessibilityAssistant::hookProfileAreas" file="$sourcedir/AccessibilityAssistant.php" reverse="true" />
  <hook hook="integrate_pre_profile_areas" function="BoredAccessibilityAssistant::hookProfileAreas" file="$sourcedir/AccessibilityAssistant.php" reverse="true" />
  <hook hook="integrate_admin_areas" function="BoredAccessibilityAssistant::hookAdmin" file="$sourcedir/AccessibilityAssistant.php" reverse="true" />
  <hook hook="integrate_load_theme" function="BoredAccessibilityAssistant::hookLoadTheme" file="$sourcedir/AccessibilityAssistant.php" reverse="true" />
  <hook hook="integrate_post_end" function="BoredAccessibilityAssistant::hookPostEnd" file="$sourcedir/AccessibilityAssistant.php" reverse="true" />
  <remove-file name="$sourcedir/AccessibilityAssistant.php" />
  <remove-file name="$themedir/AccessibilityAssistant.template.php" />
  <remove-file name="$languagedir/AccessibilityAssistant.english.php" />
  <remove-file name="$themedir/css/accessibility_assistant.css" />
  <remove-file name="$themedir/scripts/accessibility_assistant.js" />
  <database>uninstall.php</database>
 </uninstall>
</package-info>
