<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info">
<package-info xmlns="http://www.simplemachines.org/xml/package-info" xmlns:smf="http://www.simplemachines.org/">
	<id>BoredSkull:RankedPolls</id>
	<name>Ranked Polls</name>
	<version>1.1.1</version>
	<type>modification</type>

	<install for="2.1.*">
		<readme type="file" parsebbc="true">readme.txt</readme>
		<license type="file" parsebbc="false">license.txt</license>

		<database>install.php</database>

		<require-file name="Sources/RankedPolls.php" destination="$sourcedir" />
		<require-file name="Sources/RankedPolls-Admin.php" destination="$sourcedir" />
		<require-file name="Themes/default/RankedPolls.template.php" destination="$themedir" />
		<require-file name="Themes/default/css/rankedpolls.css" destination="$themedir/css" />
		<require-file name="Themes/default/scripts/rankedpolls.js" destination="$themedir/scripts" />
		<require-file name="Themes/default/languages/RankedPolls.english.php" destination="$languagedir" />

		<hook hook="integrate_pre_include" function="$sourcedir/RankedPolls.php" />
		<hook hook="integrate_actions" function="RankedPolls::actions" />
		<hook hook="integrate_load_theme" function="RankedPolls::loadTheme" />
		<hook hook="integrate_after_create_post" function="RankedPolls::afterCreatePost" />
		<hook hook="integrate_redirect" function="RankedPolls::redirect" />
		<hook hook="integrate_display_message_list" function="RankedPolls::displayMessageList" />
		<hook hook="integrate_fetch_alerts" function="RankedPolls::fetchAlerts" />
		<hook hook="integrate_load_permissions" function="RankedPolls::loadPermissions" />
		<hook hook="integrate_load_illegal_guest_permissions" function="RankedPolls::illegalGuestPermissions" />
		<hook hook="integrate_admin_areas" function="RankedPolls::adminAreas" />
		<hook hook="integrate_credits" function="RankedPolls::credits" />

		<redirect url="?action=admin;area=rankedpolls" timeout="3000" />
	</install>

	<upgrade from="1.0.*, 1.1.0" for="2.1.*">
		<readme type="file" parsebbc="true">readme.txt</readme>
		<database>upgrade.php</database>
		<require-file name="Sources/RankedPolls.php" destination="$sourcedir" />
		<require-file name="Sources/RankedPolls-Admin.php" destination="$sourcedir" />
		<require-file name="Themes/default/RankedPolls.template.php" destination="$themedir" />
		<require-file name="Themes/default/css/rankedpolls.css" destination="$themedir/css" />
		<require-file name="Themes/default/scripts/rankedpolls.js" destination="$themedir/scripts" />
		<require-file name="Themes/default/languages/RankedPolls.english.php" destination="$languagedir" />
	</upgrade>

	<uninstall for="2.1.*">
		<hook hook="integrate_pre_include" function="$sourcedir/RankedPolls.php" reverse="true" />
		<hook hook="integrate_actions" function="RankedPolls::actions" reverse="true" />
		<hook hook="integrate_load_theme" function="RankedPolls::loadTheme" reverse="true" />
		<hook hook="integrate_after_create_post" function="RankedPolls::afterCreatePost" reverse="true" />
		<hook hook="integrate_redirect" function="RankedPolls::redirect" reverse="true" />
		<hook hook="integrate_display_message_list" function="RankedPolls::displayMessageList" reverse="true" />
		<hook hook="integrate_fetch_alerts" function="RankedPolls::fetchAlerts" reverse="true" />
		<hook hook="integrate_load_permissions" function="RankedPolls::loadPermissions" reverse="true" />
		<hook hook="integrate_load_illegal_guest_permissions" function="RankedPolls::illegalGuestPermissions" reverse="true" />
		<hook hook="integrate_admin_areas" function="RankedPolls::adminAreas" reverse="true" />
		<hook hook="integrate_credits" function="RankedPolls::credits" reverse="true" />

		<!-- Always runs: removes the scheduled task so it can't call missing code -->
		<code type="file">uninstall-task.php</code>
		<!-- Runs only when "Remove all data associated with this modification" is ticked -->
		<database>uninstall.php</database>

		<remove-file name="$sourcedir/RankedPolls.php" />
		<remove-file name="$sourcedir/RankedPolls-Admin.php" />
		<remove-file name="$themedir/RankedPolls.template.php" />
		<remove-file name="$themedir/css/rankedpolls.css" />
		<remove-file name="$themedir/scripts/rankedpolls.js" />
		<remove-file name="$languagedir/RankedPolls.english.php" />
	</uninstall>
</package-info>
