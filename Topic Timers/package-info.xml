<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info.dtd">
<package-info xmlns="http://www.simplemachines.org/xml/package-info" xmlns:smf="http://www.simplemachines.org/">
 <id>boredskull:topic-timers</id><name>Topic Timers</name><version>1.0.6</version><type>modification</type><author>BoredSkull</author><license>ISC</license>
 <install for="2.1 - 2.1.99">
  <require-file name="Sources/TopicTimers.php" destination="$sourcedir" />
  <require-file name="Themes/default/TopicTimers.template.php" destination="$themedir" />
  <require-file name="Themes/default/languages/TopicTimers.english.php" destination="$languagedir" />
  <code>install.php</code>
  <hook hook="integrate_actions" function="BTT_actions" file="$sourcedir/TopicTimers.php" />
  <hook hook="integrate_display_buttons" function="BTT_buttons" file="$sourcedir/TopicTimers.php" />
  <hook hook="integrate_admin_areas" function="BTT_admin_areas" file="$sourcedir/TopicTimers.php" />
  <hook hook="integrate_modify_modifications" function="BTT_admin_tabs" file="$sourcedir/TopicTimers.php" />
  <hook hook="integrate_manage_scheduled_tasks" function="BTT_task_labels" file="$sourcedir/TopicTimers.php" />
  <redirect url="$scripturl?action=admin;area=modsettings;sa=btt;$session_var=$session_id" timeout="2000" />
 </install>
 <uninstall for="2.1 - 2.1.99">
  <code>uninstall.php</code>
  <hook hook="integrate_actions" function="BTT_actions" file="$sourcedir/TopicTimers.php" reverse="true" />
  <hook hook="integrate_display_buttons" function="BTT_buttons" file="$sourcedir/TopicTimers.php" reverse="true" />
  <hook hook="integrate_admin_areas" function="BTT_admin_areas" file="$sourcedir/TopicTimers.php" reverse="true" />
  <hook hook="integrate_modify_modifications" function="BTT_admin_tabs" file="$sourcedir/TopicTimers.php" reverse="true" />
  <hook hook="integrate_manage_scheduled_tasks" function="BTT_task_labels" file="$sourcedir/TopicTimers.php" reverse="true" />
  <remove-file name="$sourcedir/TopicTimers.php" />
  <remove-file name="$themedir/TopicTimers.template.php" />
  <remove-file name="$languagedir/TopicTimers.english.php" />
 </uninstall>
</package-info>
