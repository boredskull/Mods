<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info.dtd">
<package-info xmlns="http://www.simplemachines.org/xml/package-info" xmlns:smf="http://www.simplemachines.org/">
  <id>boredskull:enhanced-reactions</id>
  <name>Enhanced Reactions</name>
  <version>1.0.10</version>
  <type>modification</type>
  <install for="2.1 - 2.1.99">
    <readme type="file" parsebbc="false">README.md</readme>
    <license type="file" parsebbc="false">LICENSE.txt</license>
    <require-file name="Sources/BsReactions.php" destination="$sourcedir" />
    <require-file name="Sources/BsReactionsStandalone.php" destination="$sourcedir" />
    <require-file name="Sources/BsReactionsEcosystem.php" destination="$sourcedir" />
    <require-file name="Themes/default/languages/BsReactions.english.php" destination="$languagedir" />
    <require-file name="Themes/default/scripts/bs-reactions.js" destination="$themedir/scripts" />
    <require-file name="Themes/default/css/bs-reactions.css" destination="$themedir/css" />
    <code>install.php</code>
    <hook hook="integrate_actions" function="bsr_actions" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_display_message_list" function="bsr_prefetch" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_prepare_display_context" function="bsr_prepare_post" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_load_theme" function="bsr_theme" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_admin_areas" function="bsr_admin_areas" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_modify_modifications" function="bsr_modify_modifications" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_credits" function="bsr_credits" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_delete_members" function="bsr_delete_members" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_load_permissions" function="bsr_v107_permissions" file="$sourcedir/BsReactionsStandalone.php" />
    <hook hook="integrate_activity_stream_types" function="bsr_stream_types" file="$sourcedir/BsReactionsEcosystem.php" />
    <hook hook="integrate_activity_stream_fetch" function="bsr_stream_fetch" file="$sourcedir/BsReactionsEcosystem.php" />
    <hook hook="integrate_ci_providers" function="bsr_insight_provider" file="$sourcedir/BsReactionsEcosystem.php" />
  </install>
  <!-- Adds every current hook (SMF skips any already registered), so upgrades
       from older versions also get the hooks added since they were installed. -->
  <upgrade from="1.0.6 - 1.0.9" for="2.1 - 2.1.99">
    <readme type="file" parsebbc="false">README.md</readme>
    <require-file name="Sources/BsReactions.php" destination="$sourcedir" />
    <require-file name="Sources/BsReactionsStandalone.php" destination="$sourcedir" />
    <require-file name="Sources/BsReactionsEcosystem.php" destination="$sourcedir" />
    <require-file name="Themes/default/languages/BsReactions.english.php" destination="$languagedir" />
    <require-file name="Themes/default/scripts/bs-reactions.js" destination="$themedir/scripts" />
    <require-file name="Themes/default/css/bs-reactions.css" destination="$themedir/css" />
    <code>install.php</code>
    <hook hook="integrate_actions" function="bsr_actions" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_display_message_list" function="bsr_prefetch" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_prepare_display_context" function="bsr_prepare_post" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_load_theme" function="bsr_theme" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_admin_areas" function="bsr_admin_areas" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_modify_modifications" function="bsr_modify_modifications" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_credits" function="bsr_credits" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_delete_members" function="bsr_delete_members" file="$sourcedir/BsReactions.php" />
    <hook hook="integrate_load_permissions" function="bsr_v107_permissions" file="$sourcedir/BsReactionsStandalone.php" />
    <hook hook="integrate_activity_stream_types" function="bsr_stream_types" file="$sourcedir/BsReactionsEcosystem.php" />
    <hook hook="integrate_activity_stream_fetch" function="bsr_stream_fetch" file="$sourcedir/BsReactionsEcosystem.php" />
    <hook hook="integrate_ci_providers" function="bsr_insight_provider" file="$sourcedir/BsReactionsEcosystem.php" />
    <hook hook="integrate_issue_like" function="bsr_native_like_changed" file="$sourcedir/BsReactions.php" reverse="true" />
  </upgrade>
  <uninstall for="2.1 - 2.1.99">
    <hook hook="integrate_actions" function="bsr_actions" file="$sourcedir/BsReactions.php" reverse="true" />
    <hook hook="integrate_display_message_list" function="bsr_prefetch" file="$sourcedir/BsReactions.php" reverse="true" />
    <hook hook="integrate_prepare_display_context" function="bsr_prepare_post" file="$sourcedir/BsReactions.php" reverse="true" />
    <hook hook="integrate_load_theme" function="bsr_theme" file="$sourcedir/BsReactions.php" reverse="true" />
    <hook hook="integrate_admin_areas" function="bsr_admin_areas" file="$sourcedir/BsReactions.php" reverse="true" />
    <hook hook="integrate_modify_modifications" function="bsr_modify_modifications" file="$sourcedir/BsReactions.php" reverse="true" />
    <hook hook="integrate_credits" function="bsr_credits" file="$sourcedir/BsReactions.php" reverse="true" />
    <hook hook="integrate_delete_members" function="bsr_delete_members" file="$sourcedir/BsReactions.php" reverse="true" />
    <hook hook="integrate_load_permissions" function="bsr_v107_permissions" file="$sourcedir/BsReactionsStandalone.php" reverse="true" />
    <hook hook="integrate_activity_stream_types" function="bsr_stream_types" file="$sourcedir/BsReactionsEcosystem.php" reverse="true" />
    <hook hook="integrate_activity_stream_fetch" function="bsr_stream_fetch" file="$sourcedir/BsReactionsEcosystem.php" reverse="true" />
    <hook hook="integrate_ci_providers" function="bsr_insight_provider" file="$sourcedir/BsReactionsEcosystem.php" reverse="true" />
    <hook hook="integrate_issue_like" function="bsr_native_like_changed" file="$sourcedir/BsReactions.php" reverse="true" />
    <remove-file name="$sourcedir/BsReactions.php" />
    <remove-file name="$sourcedir/BsReactionsStandalone.php" />
    <remove-file name="$sourcedir/BsReactionsEcosystem.php" />
    <remove-file name="$languagedir/BsReactions.english.php" />
    <remove-file name="$themedir/scripts/bs-reactions.js" />
    <remove-file name="$themedir/css/bs-reactions.css" />
  </uninstall>
</package-info>
