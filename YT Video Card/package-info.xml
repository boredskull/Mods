<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info">
<package-info xmlns="http://www.simplemachines.org/xml/package-info" xmlns:smf="http://www.simplemachines.org/">
	<id>boredskull:YouTubeVideoCard</id>
	<name>YouTube Video Card</name>
	<version>1.0.1</version>
	<type>modification</type>

	<install for="2.1.*">
		<require-file name="Sources/YtCard.php" destination="$sourcedir" />
		<require-file name="Themes/default/scripts/ytcard.js" destination="$themedir/scripts" />
		<require-file name="Themes/default/css/ytcard.css" destination="$themedir/css" />
		<require-file name="Themes/default/languages/YtCard.english.php" destination="$languagedir" />

		<database>install.php</database>

		<hook hook="integrate_load_theme" function="ytcard_load_theme" file="$sourcedir/YtCard.php" />
		<hook hook="integrate_bbc_codes" function="ytcard_bbc_codes" file="$sourcedir/YtCard.php" />
		<hook hook="integrate_actions" function="ytcard_actions" file="$sourcedir/YtCard.php" />
		<hook hook="integrate_admin_areas" function="ytcard_admin_areas" file="$sourcedir/YtCard.php" />
		<hook hook="integrate_modify_modifications" function="ytcard_modify_modifications" file="$sourcedir/YtCard.php" />
		<hook hook="integrate_credits" function="ytcard_credits" file="$sourcedir/YtCard.php" />

		<redirect url="?action=admin;area=modsettings;sa=ytcard" timeout="3000" />
	</install>

	<uninstall for="2.1.*">
		<hook hook="integrate_load_theme" function="ytcard_load_theme" file="$sourcedir/YtCard.php" reverse="true" />
		<hook hook="integrate_bbc_codes" function="ytcard_bbc_codes" file="$sourcedir/YtCard.php" reverse="true" />
		<hook hook="integrate_actions" function="ytcard_actions" file="$sourcedir/YtCard.php" reverse="true" />
		<hook hook="integrate_admin_areas" function="ytcard_admin_areas" file="$sourcedir/YtCard.php" reverse="true" />
		<hook hook="integrate_modify_modifications" function="ytcard_modify_modifications" file="$sourcedir/YtCard.php" reverse="true" />
		<hook hook="integrate_credits" function="ytcard_credits" file="$sourcedir/YtCard.php" reverse="true" />
		
		<remove-file name="$sourcedir/YtCard.php" />
		<remove-file name="$themedir/scripts/ytcard.js" />
		<remove-file name="$themedir/css/ytcard.css" />
		<remove-file name="$languagedir/YtCard.english.php" />

		<database>uninstall-optional.php</database>
	</uninstall>
</package-info>
