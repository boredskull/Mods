<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info">
<package-info xmlns="http://www.simplemachines.org/xml/package-info" xmlns:smf="http://www.simplemachines.org/">
	<id>BoredSkull:Clubs</id>
	<name>Clubs</name>
	<version>1.1.3</version>
	<type>modification</type>

	<install for="2.1.*">
		<readme type="file" parsebbc="true">readme.txt</readme>
		<license type="file" parsebbc="false">license.txt</license>

		<require-file name="Sources/Clubs.php" destination="$sourcedir" />
		<require-file name="Sources/Clubs-Pages.php" destination="$sourcedir" />
		<require-file name="Themes/default/Clubs.template.php" destination="$themedir" />
		<require-file name="Themes/default/css/clubs.css" destination="$themedir/css" />
		<require-file name="Themes/default/scripts/clubs.js" destination="$themedir/scripts" />
		<require-file name="Themes/default/languages/Clubs.english.php" destination="$languagedir" />
		<require-dir name="Themes/default/images/clubs" destination="$imagesdir" />

		<!-- After the files, because it uses the Clubs class to set up the category and permission profile -->
		<database>install.php</database>

		<hook hook="integrate_pre_include" function="$sourcedir/Clubs.php" />
		<hook hook="integrate_actions" function="Clubs::actions" />
		<hook hook="integrate_menu_buttons" function="Clubs::menuButtons" />
		<hook hook="integrate_load_theme" function="Clubs::loadTheme" />
		<hook hook="integrate_mark_read_button" function="Clubs::boardIndex" />
		<hook hook="integrate_delete_members" function="Clubs::deleteMembers" />
		<hook hook="integrate_fetch_alerts" function="Clubs::fetchAlerts" />
		<hook hook="integrate_load_permissions" function="Clubs::loadPermissions" />
		<hook hook="integrate_load_illegal_guest_permissions" function="Clubs::illegalGuestPermissions" />
		<hook hook="integrate_admin_areas" function="Clubs::adminAreas" />
		<hook hook="integrate_credits" function="Clubs::credits" />

		<redirect url="?action=admin;area=clubs" timeout="3000" />
	</install>

	<upgrade from="1.0.0-1.1.2" for="2.1.*">
		<readme type="file" parsebbc="true">readme.txt</readme>
		<require-file name="Sources/Clubs.php" destination="$sourcedir" />
		<require-file name="Sources/Clubs-Pages.php" destination="$sourcedir" />
		<require-file name="Themes/default/Clubs.template.php" destination="$themedir" />
		<require-file name="Themes/default/css/clubs.css" destination="$themedir/css" />
		<require-file name="Themes/default/scripts/clubs.js" destination="$themedir/scripts" />
		<require-file name="Themes/default/languages/Clubs.english.php" destination="$languagedir" />
		<require-dir name="Themes/default/images/clubs" destination="$imagesdir" />

		<!-- Gives each club its own permission profile, moves existing bans and moderators over -->
		<database>install.php</database>
	</upgrade>

	<uninstall for="2.1.*">
		<hook hook="integrate_pre_include" function="$sourcedir/Clubs.php" reverse="true" />
		<hook hook="integrate_actions" function="Clubs::actions" reverse="true" />
		<hook hook="integrate_menu_buttons" function="Clubs::menuButtons" reverse="true" />
		<hook hook="integrate_load_theme" function="Clubs::loadTheme" reverse="true" />
		<hook hook="integrate_mark_read_button" function="Clubs::boardIndex" reverse="true" />
		<hook hook="integrate_delete_members" function="Clubs::deleteMembers" reverse="true" />
		<hook hook="integrate_fetch_alerts" function="Clubs::fetchAlerts" reverse="true" />
		<hook hook="integrate_load_permissions" function="Clubs::loadPermissions" reverse="true" />
		<hook hook="integrate_load_illegal_guest_permissions" function="Clubs::illegalGuestPermissions" reverse="true" />
		<hook hook="integrate_admin_areas" function="Clubs::adminAreas" reverse="true" />
		<hook hook="integrate_credits" function="Clubs::credits" reverse="true" />

		<!-- Runs only when "Remove all data associated with this modification" is ticked.
		     Club boards, their topics and the club membergroups are kept as normal SMF boards and groups. -->
		<database>uninstall.php</database>

		<remove-file name="$sourcedir/Clubs.php" />
		<remove-file name="$sourcedir/Clubs-Pages.php" />
		<remove-file name="$themedir/Clubs.template.php" />
		<remove-file name="$themedir/css/clubs.css" />
		<remove-file name="$themedir/scripts/clubs.js" />
		<remove-file name="$languagedir/Clubs.english.php" />
	</uninstall>
</package-info>
